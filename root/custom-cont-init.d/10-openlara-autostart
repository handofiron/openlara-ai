#!/usr/bin/with-contenv bash
set -euo pipefail

cat > /defaults/autostart <<'AUTOSTART'
#!/usr/bin/env bash
set -u

game_dir="${OPENLARA_GAME_DIR:-/game}"
save_dir="${OPENLARA_SAVE_DIR:-/config/openlara}"

mkdir -p "$save_dir"

if [ ! -x "$game_dir/OpenLara" ]; then
    xmessage -center \
        'OpenLara game data is not installed yet.\n\nRun the host import script, then restart this container.' &
    exit 0
fi

(
    cd "$game_dir" || exit 1

    exec env \
        HOME="$save_dir" \
        LIBGL_ALWAYS_SOFTWARE=0 \
        MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-iris}" \
        "$game_dir/OpenLara"
) &
AUTOSTART

chmod 0755 /defaults/autostart
