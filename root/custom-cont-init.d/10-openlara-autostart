#!/usr/bin/with-contenv bash
set -euo pipefail

mkdir -p \
    /config/ssl \
    /config/.config/openbox \
    /config/openlara \
    /config/nginx

if [ ! -s /config/ssl/cert.pem ] || [ ! -s /config/ssl/cert.key ]; then
    openssl req -x509 -nodes -newkey rsa:2048 \
        -keyout /config/ssl/cert.key \
        -out /config/ssl/cert.pem \
        -days 3650 \
        -subj '/CN=open-lara.local'
    chmod 600 /config/ssl/cert.key
fi

if [ -z "${DESKTOP_USER:-}" ] || [ -z "${DESKTOP_PASSWORD:-}" ]; then
    echo "DESKTOP_USER and DESKTOP_PASSWORD must be set." >&2
    exit 1
fi

htpasswd -Bbc /config/nginx/.htpasswd "$DESKTOP_USER" "$DESKTOP_PASSWORD"
chmod 600 /config/nginx/.htpasswd

cat > /etc/nginx/sites-enabled/default <<'NGINX'
server {
    auth_basic "OpenLara browser desktop";
    auth_basic_user_file /config/nginx/.htpasswd;
    listen 3001 ssl default_server;
    listen [::]:3001 ssl default_server;

    ssl_certificate     /config/ssl/cert.pem;
    ssl_certificate_key /config/ssl/cert.key;

    location / {
        alias /usr/share/selkies/web/;
        index index.html index.htm;
        try_files $uri $uri/ =404;
    }

    location /websocket {
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_connect_timeout 3600s;
        proxy_buffering off;
        client_max_body_size 10M;
        proxy_pass http://127.0.0.1:8082;
    }

    location /files {
        fancyindex on;
        fancyindex_footer /nginx/footer.html;
        fancyindex_header /nginx/header.html;
        alias /config/Desktop/;
        if (-f $request_filename) {
            add_header Content-Disposition "attachment";
            add_header X-Content-Type-Options "nosniff";
        }
    }
}
NGINX

cat > /config/.config/openbox/autostart <<'AUTOSTART'
#!/usr/bin/env bash
set -u

game_dir="${OPENLARA_GAME_DIR:-/game}"
save_dir="${OPENLARA_SAVE_DIR:-/config/openlara}"

mkdir -p "$save_dir"

if [ -x "$game_dir/OpenLara" ]; then
    (
        cd "$game_dir" || exit 1
        exec env \
            HOME="$save_dir" \
            LIBGL_ALWAYS_SOFTWARE=0 \
            MESA_LOADER_DRIVER_OVERRIDE="${MESA_LOADER_DRIVER_OVERRIDE:-iris}" \
            "$game_dir/OpenLara"
    ) &
fi
AUTOSTART

chmod 0755 /config/.config/openbox/autostart
nginx -t
